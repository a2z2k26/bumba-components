{
  "name": "tool-bridge",
  "version": "1.0.0",
  "description": "Tool Bridge - The Universal AI Development Gateway",
  "main": "src/index.js",
  "bin": {
    "tool-bridge": "./src/cli/index.js"
  },
  "scripts": {
    "start": "node src/cli/index.js start",
    "setup": "node src/cli/index.js setup",
    "test": "jest --coverage --passWithNoTests",
    "test:watch": "jest --watch",
    "lint": "eslint src/",
    "lint:fix": "eslint src/ --fix",
    "format": "prettier --write src/",
    "security": "npm audit",
    "build": "npm run lint && npm test",
    "docker:build": "docker build -t tool-bridge -f docker/Dockerfile .",
    "docker:run": "docker run -p 3456:3456 tool-bridge",
    "prepublishOnly": "npm run build",
    "version": "npm run format && git add -A src",
    "postversion": "git push && git push --tags"
  },
  "keywords": [
    "tool-bridge",
    "universal-gateway",
    "openai",
    "anthropic",
    "claude",
    "gemini",
    "api",
    "gateway",
    "proxy",
    "unified"
  ],
  "author": "Tool Bridge Contributors",
  "license": "MIT",
  "homepage": "https://github.com/tool-bridge/tool-bridge#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tool-bridge/tool-bridge.git"
  },
  "bugs": {
    "url": "https://github.com/tool-bridge/tool-bridge/issues"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "helmet": "^7.0.0",
    "compression": "^1.7.4",
    "express-rate-limit": "^6.10.0",
    "jsonwebtoken": "^9.0.2",
    "dotenv": "^16.3.1",
    "commander": "^11.0.0",
    "inquirer": "^8.2.6",
    "chalk": "^4.1.2",
    "ora": "^5.4.1",
    "axios": "^1.5.0",
    "ws": "^8.14.0",
    "joi": "^17.9.2",
    "winston": "^3.10.0",
    "node-fetch": "^2.7.0"
  },
  "devDependencies": {
    "jest": "^29.6.4",
    "eslint": "^8.48.0",
    "nodemon": "^3.0.1"
  },
  "engines": {
    "node": ">=16.0.0"
  }
}